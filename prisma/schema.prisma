// Prisma schema — Soirée Manager
// Voir PROJECT.md pour le contexte complet

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "../docs/erd.svg"
  theme                     = "default"
  includeRelationFromFields = true
  disabled                  = env("DISABLE_ERD")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  ORGANIZER
  TREASURER
  VOLUNTEER
  ARTIST
  VIEWER
}

enum EventStatus {
  DRAFT
  PLANNING
  LIVE
  DONE
  ARCHIVED
}

enum ParticipantRole {
  GUEST
  VOLUNTEER
  ARTIST
  STAFF
  SUPPLIER
}

enum TaskStatus {
  TODO
  DOING
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MED
  HIGH
}

enum ReimbStatus {
  PENDING
  DONE
  NOT_OWED
}

enum RunOfShowStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DELAYED
  CANCELLED
}

enum Ownership {
  OWNED
  BORROWED
  RENTED
}

enum RsvpStatus {
  UNKNOWN
  YES
  NO
  MAYBE
}

enum TicketSource {
  MANUAL
  API_SHOTGUN
  // TODO: API_SHOTGUN, API_HELLOASSO, etc. — ajouter les valeurs lors des intégrations billetterie
}

enum PersonType {
  CONTACT
  ARTIST
  SUPPLIER
  VENDOR
  VENUE
}

enum BudgetPhase {
  FORECAST
  ACTUAL
}

enum AmountInputMode {
  HT
  TTC
}

enum VatMode {
  NON_ASSUJETTI
  ASSUJETTI
}

enum SacemBase {
  TICKETING
  TOTAL_REVENUE
}

// ============================================================
// PERSISTENT ENTITIES (pas liées à un event spécifique)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(VIEWER)
  discordUserId String?   @unique
  defaultWorkspaceId String?
  defaultWorkspace   Workspace? @relation("DefaultWorkspace", fields: [defaultWorkspaceId], references: [id])
  personId      String?   @unique
  person        Person?   @relation(fields: [personId], references: [id])
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?

  accounts      Account[]
  sessions      Session[]
  workspaceMemberships WorkspaceMember[]
  eventCollaborations   EventCollaborator[]

  @@index([defaultWorkspaceId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  shotgunOrganizerId String?
  shotgunApiToken    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultUsers User[] @relation("DefaultWorkspace")
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  eventCollaborators EventCollaborator[]
  persons      Person[]
  venues       Venue[]
  suppliers    Supplier[]
  equipmentItems  EquipmentItem[]
  equipmentGroups EquipmentGroup[]
  events          Event[]
}

model EventCollaborator {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  token       String   @unique
  expires     DateTime
  acceptedAt  DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([workspaceId])
  @@index([email])
  @@index([userId])
  @@unique([eventId, email])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole  @default(VIEWER)
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  token       String   @unique
  expires     DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
  @@unique([workspaceId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Person {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullName      String
  email         String?
  phone         String?
  discordUserId String?
  notes         String?
  tags          String[]
  contactType          PersonType @default(CONTACT)
  availability         String?
  negotiatedPrices     String?
  specialConditions    String?
  technicalConstraints String?
  averageFee           Int?
  bookingContact       String?
  musicalStyle         String?
  riderNotes           String?
  venueCapacity        Int?
  soundConstraints     String?
  openingHours         String?
  electricalPower      String?
  securityContact      String?
  sensibleNeighborhood Boolean   @default(false)
  archivedAt    DateTime?

  user          User?
  participations EventParticipant[]
  expensesPaid   Expense[]          @relation("PaidBy")
  tasksAssigned  Task[]             @relation("TaskAssignee")
  shifts         Shift[]
  shoppingItems  ShoppingItem[]     @relation("ShoppingBuyer")
  equipmentOwned     EquipmentItem[] @relation("EquipmentOwner")
  equipmentSupplied  EquipmentItem[] @relation("EquipmentSupplier")
  announcements  Announcement[]     @relation("AnnouncementAuthor")
  runOfShowResponsible RunOfShowItem[] @relation("RunOfShowResponsible")
  documents            PersonDocument[]
  historyNotes         PersonHistoryNote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([archivedAt])
  @@index([workspaceId])
  @@unique([workspaceId, email])
  @@unique([workspaceId, discordUserId])
}

model PersonDocument {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String
  url       String
  isUpload  Boolean  @default(false)
  category  String
  createdAt DateTime @default(now())

  @@index([personId])
}

model PersonHistoryNote {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  body      String
  eventDate DateTime?
  createdAt DateTime  @default(now())

  @@index([personId])
}

model Venue {
  id         String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  capacity   Int?
  notes      String?
  archivedAt DateTime?

  events     Event[]

  @@index([workspaceId])
}

model Supplier {
  id         String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name       String
  category   String
  contact    String?
  notes      String?
  archivedAt DateTime?

  @@index([workspaceId])
}

model EquipmentItem {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  category       String
  ownership      Ownership
  ownerId        String?
  owner          Person?   @relation("EquipmentOwner", fields: [ownerId], references: [id])
  supplierId     String?
  supplier       Person?   @relation("EquipmentSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  photoUrl       String?
  color          String?
  unitPriceCents Int       @default(0)
  rentalCoef     Decimal   @default(1) @db.Decimal(5, 2)
  quantity       Int       @default(1)
  notes          String?
  archivedAt     DateTime?

  usages         EquipmentUsage[]
  groupItems     EquipmentGroupItem[]

  @@index([workspaceId])
  @@index([category])
}

model EquipmentGroup {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  items       EquipmentGroupItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([workspaceId])
}

model EquipmentGroupItem {
  id       String         @id @default(cuid())
  groupId  String
  group    EquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemId   String
  item     EquipmentItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int            @default(1)

  @@unique([groupId, itemId])
  @@index([groupId])
}

// ============================================================
// EVENT-SCOPED ENTITIES
// ============================================================

model Event {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  shotgunEventId Int?        @unique
  startsAt      DateTime
  endsAt        DateTime?
  status        EventStatus @default(DRAFT)
  description   String?
  bannerUrl     String?
  venueId       String?
  venue         Venue?      @relation(fields: [venueId], references: [id])
  parentEventId      String?     // si cloné depuis un autre event
  nbCollectifs       Int     @default(1)
  kegUnitPriceCents  Int     @default(0)
  avgBasketCents     Int     @default(0)
  vatMode            VatMode @default(NON_ASSUJETTI)
  defaultVatRateBasisPoints Int @default(2000)
  sacemRateBasisPoints Int @default(1150)
  sacemBase          SacemBase @default(TICKETING)

  participants    EventParticipant[]
  tasks           Task[]
  shifts          Shift[]
  runOfShow       RunOfShowItem[]
  runOfShowTracks RunOfShowTrack[]
  runOfShowSections RunOfShowSection[]
  expenses        Expense[]
  incomes         Income[]
  shopping        ShoppingItem[]
  equipmentUsages EquipmentUsage[]
  announcements   Announcement[]
  documents       Document[]
  channels        Channel[]
  taskCalendarSubscriptions TaskCalendarSubscription[]
  ticketTiers      TicketTier[]
  consumables      ConsumableItem[]
  equipmentQuotes  EquipmentQuote[]
  collaborators    EventCollaborator[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
  @@index([startsAt])
  @@index([status])
}

model TaskCalendarSubscription {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@unique([eventId])
  @@index([token])
}

model EventParticipant {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id])

  roles     ParticipantRole[]

  // Champs invité
  rsvpStatus    RsvpStatus @default(UNKNOWN)
  plusOnes      Int        @default(0)
  dietary       String?

  // Champs artiste
  setStart      DateTime?
  setEnd        DateTime?
  fee           Decimal?   @db.Decimal(10, 2)
  rider         Json?
  contractSigned Boolean   @default(false)

  // Notes internes orga (sensibles)
  internalNotes String?
  autoExpense   Expense?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
}

model Task {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MED)
  dueAt       DateTime?
  assigneeId  String?
  assignee    Person?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  runOfShowItem RunOfShowItem?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId, status])
  @@index([assigneeId])
  @@index([dueAt])
}

model Shift {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position   String   // "Bar 1", "Accueil", "Régie son"
  startsAt   DateTime
  endsAt     DateTime
  assigneeId String?
  assignee   Person?  @relation(fields: [assigneeId], references: [id])
  notes      String?
  reminderSentAt DateTime?

  @@index([eventId, startsAt])
  @@index([assigneeId])
}

model RunOfShowTrack {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  position  Int      @default(0)

  items     RunOfShowItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId, position])
}

model RunOfShowSection {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  position  Int      @default(0)

  items     RunOfShowItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId, position])
}

model RunOfShowItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId     String?
  track       RunOfShowTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  sectionId   String?
  section     RunOfShowSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  status      RunOfShowStatus @default(PLANNED)
  startsAt    DateTime
  durationMin Int
  title       String
  responsible String?
  responsiblePersonId String?
  responsiblePerson   Person? @relation("RunOfShowResponsible", fields: [responsiblePersonId], references: [id])
  sourceTaskId String? @unique
  sourceTask   Task?   @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  notes       String?
  stakeholderNote String?
  delayReason String?
  actualStartedAt DateTime?
  completedAt DateTime?
  dependsOn   RunOfShowDependency[] @relation("RunOfShowDependencyItem")
  dependents  RunOfShowDependency[] @relation("RunOfShowDependencyDependsOn")

  @@index([eventId, startsAt])
  @@index([trackId])
  @@index([sectionId])
  @@index([status])
  @@index([responsiblePersonId])
}

model RunOfShowDependency {
  id          String @id @default(cuid())
  itemId      String
  item        RunOfShowItem @relation("RunOfShowDependencyItem", fields: [itemId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   RunOfShowItem @relation("RunOfShowDependencyDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([itemId, dependsOnId])
  @@index([dependsOnId])
}

model Expense {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceParticipantId String? @unique
  sourceParticipant    EventParticipant? @relation(fields: [sourceParticipantId], references: [id], onDelete: Cascade)
  label         String
  amountCents   Int
  phase         BudgetPhase @default(ACTUAL)
  amountInputMode AmountInputMode @default(TTC)
  vatRateBasisPoints Int @default(0)
  amountHtCents Int @default(0)
  amountVatCents Int @default(0)
  amountTtcCents Int @default(0)
  category      String
  paidById      String?
  paidBy        Person?     @relation("PaidBy", fields: [paidById], references: [id])
  paidAt        DateTime?
  reimbursement    ReimbStatus @default(PENDING)
  receiptUrl       String?
  notes            String?
  isEquipmentSync   Boolean @default(false)
  equipmentQuoteId  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, category])
  @@index([paidById])
}

model Income {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  phase       BudgetPhase @default(ACTUAL)
  amountInputMode AmountInputMode @default(TTC)
  vatRateBasisPoints Int @default(0)
  amountHtCents Int @default(0)
  amountVatCents Int @default(0)
  amountTtcCents Int @default(0)
  category    String   // bar, merch, caisse, sponsor, autre
  receivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

model TicketTier {
  id                    String       @id @default(cuid())
  eventId               String
  event                 Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                  String
  shotgunDealId         Int?         @unique
  organizerRevenueCents Int
  publicPriceCents      Int
  quantity              Int
  sold                  Int          @default(0)
  excludeFromBreakEven  Boolean      @default(false)
  source                TicketSource @default(MANUAL)
  archivedAt            DateTime?

  @@index([eventId])
}

model EquipmentQuote {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label         String
  discountCents Int?
  discountPct   Decimal?         @db.Decimal(5, 2)
  fileUrl       String?
  usages        EquipmentUsage[]

  @@index([eventId])
}

model ConsumableItem {
  id             String  @id @default(cuid())
  eventId        String
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  unitPriceCents Int
  estimatedQty   Decimal @default(0) @db.Decimal(10, 2)

  @@index([eventId])
}

model ShoppingItem {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String?
  category       String
  estimatedCents Int?
  buyerId        String?
  buyer          Person?  @relation("ShoppingBuyer", fields: [buyerId], references: [id])
  bought         Boolean  @default(false)
  expenseId      String?  // lien quand acheté

  @@index([eventId, bought])
}

model EquipmentUsage {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  itemId          String?        // null = item exceptionnel (one-off)
  item            EquipmentItem? @relation(fields: [itemId], references: [id])
  name            String?        // nom one-off ou override
  category        String?        // catégorie one-off
  unitPriceCents  Int            @default(0)
  rentalCoef      Decimal        @default(1) @db.Decimal(5, 2)
  quantity        Int            @default(1)
  conditionBefore String?
  conditionAfter  String?
  returned        Boolean        @default(false)
  notes           String?

  quoteId         String?
  quote           EquipmentQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  // Postgres treats NULL != NULL in unique indexes: several one-offs (itemId null) allowed per event
  @@unique([eventId, itemId])
  @@index([eventId])
  @@index([itemId])
  @@index([quoteId])
}

model Document {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  url       String
  category  String   // contrat, devis, plan, rider
  createdAt DateTime @default(now())
}

model Channel {
  id            String  @id @default(cuid())
  eventId       String
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label         String  // "annonces", "logistique"
  discordChannelId String
  webhookUrl    String?

  announcements Announcement[]

  @@unique([eventId, label])
}

model Announcement {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id])
  body      String
  sentAt    DateTime?
  authorId  String
  author    Person    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([eventId])
}
